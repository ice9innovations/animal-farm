# qwen-cpp Vision Service Configuration

# Flask REST API port
PORT=7796
PRIVATE=False

# llama-server binary — built by llama-cpp/build_server.sh (shared with qwen-cpp)
LLAMA_SERVER_BIN=/workspace/llama-server/build/bin/llama-server

# llama-server network config
LLAMA_SERVER_HOST=http://127.0.0.1:11436
LLAMA_SERVER_PORT=11436
N_GPU_LAYERS=99

# Model file paths (on RunPod, point to /workspace/qwen-cpp/)
MODEL_PATH=/workspace/qwen-cpp/Qwen3-VL-2B-Instruct-Q4_K_M.gguf
MMPROJ_PATH=/workspace/qwen-cpp/mmproj-Qwen3-VL-2B-Instruct-F16.gguf
MODEL_NAME=qwen3-vl-2b

PROMPT="Write one concise factual caption for this image in 25 words or fewer. Mention only the main visible subject and action. Mention the setting only when it is important. Include visible text only when it is prominent."

TEMPERATURE=0.3
AUTO_UPDATE=true
