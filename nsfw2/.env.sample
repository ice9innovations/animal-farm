# API Configuration
PORT=7774
PRIVATE=false

# NSFW Detection Configuration (OpenNSFW2)
NSFW_THRESHOLD=50
NSFW_WARMUP=true
NSFW_INFERENCE_LOCK=true
NSFW_REQUIRE_GPU=true

# YAHOO preserves OpenNSFW2's default preprocessing. SIMPLE is faster but can change scores.
NSFW_PREPROCESSING=YAHOO

# Compute mode: cpu or gpu
MODE=gpu
